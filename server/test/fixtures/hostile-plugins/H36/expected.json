{
  "case": "H36",
  "title": "publicRoutes refuse a request from another site",
  "requests": [
    {
      "method": "POST",
      "path": "/join",
      "anonymous": true,
      "headers": {
        "Sec-Fetch-Site": "cross-site",
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "rawBody": "a=1",
      "expect": {
        "status": 403,
        "headersAbsent": [
          "set-cookie"
        ]
      }
    },
    {
      "method": "POST",
      "path": "/join",
      "anonymous": true,
      "headers": {
        "Sec-Fetch-Site": "same-site"
      },
      "body": {},
      "expect": {
        "status": 403
      }
    },
    {
      "method": "GET",
      "path": "/count",
      "anonymous": true,
      "headers": {
        "Sec-Fetch-Site": "same-origin"
      },
      "expect": {
        "status": 200,
        "body": {
          "n": 0
        }
      }
    }
  ],
  "alwaysCheck": [
    "health",
    "coreDbUnchanged",
    "noFileOutsidePluginDir"
  ],
  "why": "The plugin's code never runs for a cross-site request: the counter stays at 0."
}
