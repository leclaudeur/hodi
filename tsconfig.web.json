{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/test/**/*.ts",
    "shared/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
