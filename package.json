{
  "name": "@hodi-app/hodi",
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json && tsc -p tsconfig.plugins.json",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --disable-warning=ExperimentalWarning --test \"server/test/**/*.test.ts\"",
    "test:web": "vitest run",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-exclude=\"server/test/**\" --test-reporter=dot --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage-server.lcov --test \"server/test/**/*.test.ts\"",
    "test:e2e": "vite build && playwright test",
    "plugin:build": "node --disable-warning=ExperimentalWarning plugin-sdk/bin.ts",
    "plugin-sdk:build": "npm run build --prefix plugin-sdk",
    "plugin-sdk:check": "node --disable-warning=ExperimentalWarning plugin-sdk/check-package.ts",
    "sources:list": "node --disable-warning=ExperimentalWarning server/cli/list-sources.ts",
    "lint": "eslint . --max-warnings 0",
    "deadcode": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@floating-ui/react-dom": "2.1.9",
    "@internationalized/date": "^3.12.4",
    "@mozilla/readability": "^0.6.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-fr": "^4.1.2",
    "compression": "^1.8.2",
    "eld": "^2.1.1",
    "entities": "^9.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "express-static-gzip": "^3.0.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "0.8.3",
    "i18next": "^26.7.2",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "node-sqlite3-wasm": "0.8.61",
    "nodemailer": "^10.4.0",
    "otpauth": "^9.6.0",
    "piscina": "^5.3.2",
    "qrcode-generator": "^2.0.4",
    "quickjs-emscripten": "0.32.0",
    "react-aria-components": "^1.22.1",
    "react-day-picker": "10.0.2",
    "react-i18next": "^17.1.13",
    "react-remove-scroll": "2.7.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.37.0",
    "sonner": "2.0.8",
    "tar": "^7.5.22",
    "undici": "^8.12.4",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@videojs/react": "10.3.0",
    "@videojs/youtube-video": "10.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "lucide-react": "1.70.0",
    "overlayscrollbars": "2.17.0",
    "overlayscrollbars-react": "0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-share": "6.1.0",
    "recharts": "3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
